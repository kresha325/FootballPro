# Local development .env example for backend
# Copy this file to `.env` and adjust values for your local Postgres

# Database
DB_USER=postgres
DB_PASS=your_db_password
DB_NAME=jonsport_dev
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
PGSSLMODE=disable

# App
NODE_ENV=development
PORT=10000

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Internal token shared with mediasoup-server for stream/viewer internal callbacks
MEDIASOUP_ADMIN_TOKEN=replace-with-random-token

# Cloudinary (optional — used for media uploads)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Mailer — i detyrueshëm për email prindi, reset password, welcome
# Gmail: aktivizo 2FA → App Password → https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
# Opsionale SMTP (në vend të Gmail service):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# JonCoin: nëse `true`, POST /api/joncoin/purchase kredito menjëherë (pa pritje admin) — përdore vetëm në dev/test
JONCOIN_AUTO_COMPLETE_PURCHASE=false

# JonCoin: komision në tërheqje (0–25). Të gjithë përdoruesit që kërkojnë withdraw paguajnë nga shuma e kërkuar (net në WithdrawalRequest = bruto − komision).
JONCOIN_WITHDRAW_COMMISSION_PERCENT=5

# Payments: leave false until you intentionally launch Stripe (premium + marketplace card)
PAYMENTS_ENABLED=false

# OpenAI (bio, përmbledhje skauti, sugjerime postimesh)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_DAILY_LIMIT_PER_USER=15

# YouTube test channel (optional — same as frontend VITE_YOUTUBE_TEST_CHANNEL_ID)
# YOUTUBE_TEST_CHANNEL_ID=UCflsCrcGKQ85RYdNM5oW27w
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Notes:
# - When running locally with a standard Postgres instance, set DB_HOST=localhost and DB_SSL=false.
# - For production, set DATABASE_URL and PGSSLMODE appropriately (e.g., verify-full) and provide CA certs if required.
# - After creating .env, run `npm run dev` inside the `backend` folder to start the server.
