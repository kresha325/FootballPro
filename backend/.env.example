# Local development .env example for backend
# Copy this file to `.env` and adjust values for your local Postgres

# Database
DB_USER=postgres
DB_PASS=your_db_password
DB_NAME=jonsport_dev
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
PGSSLMODE=disable

# App
NODE_ENV=development
PORT=10000

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Internal token shared with mediasoup-server for stream/viewer internal callbacks
MEDIASOUP_ADMIN_TOKEN=replace-with-random-token

# Cloudinary (optional — used for media uploads)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Upload caps (bytes). Videos for feed/posts default 100MB; images 10MB.
# UPLOAD_MAX_IMAGE_BYTES=10485760
# UPLOAD_MAX_VIDEO_BYTES=104857600


# Mailer — i detyrueshëm për email prindi, reset password, welcome
# Gmail: aktivizo 2FA → App Password → https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
# Opsionale SMTP (në vend të Gmail service):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# JonCoin: nëse `true`, POST /api/joncoin/purchase kredito menjëherë (pa pritje admin) — përdore vetëm në dev/test
JONCOIN_AUTO_COMPLETE_PURCHASE=false

# JonCoin: komision në tërheqje (0–25). Të gjithë përdoruesit që kërkojnë withdraw paguajnë nga shuma e kërkuar (net në WithdrawalRequest = bruto − komision).
JONCOIN_WITHDRAW_COMMISSION_PERCENT=5

# Payments: leave false until you intentionally launch Stripe (premium + marketplace card)
PAYMENTS_ENABLED=false

# CORS (comma-separated). Defaults include xtalenti.com + localhost Vite ports.
# On Render, also add any preview / GitHub Pages origins you use:
# CORS_ORIGIN=https://xtalenti.com,https://www.xtalenti.com,https://your-preview.example
# FRONTEND_URL=https://xtalenti.com

# Facebook Login / Open Graph (public App ID — also clears Sharing Debugger fb:app_id warning)
# FACEBOOK_APP_ID=123456789012345
# FACEBOOK_APP_SECRET=...

# Google OAuth (Login with Google on web + mobile deep link)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (SPA relay → API):
#   https://xtalenti.com/auth/google/callback
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# FRONTEND_URL=https://xtalenti.com

# Optional override (defaults to FRONTEND_URL + /auth/google/callback):
# GOOGLE_CALLBACK_URL=https://xtalenti.com/auth/google/callback
# FACEBOOK_CALLBACK_URL=https://xtalenti.com/auth/facebook/callback

# Apple Sign In (Services ID + Key .p8)
# https://developer.apple.com/account/resources/identifiers/list/serviceId
# Return URL: https://YOUR-RENDER-HOST/api/auth/apple/callback
# APPLE_CLIENT_ID=com.yourcompany.xtalenti.web   # Services ID
# APPLE_TEAM_ID=ABCDE12345
# APPLE_KEY_ID=XYZ123ABCD
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional override (defaults to RENDER_EXTERNAL_URL + /api/auth/apple/callback):
# APPLE_CALLBACK_URL=https://footballpro.onrender.com/api/auth/apple/callback
# BACKEND_PUBLIC_URL=https://footballpro.onrender.com

# OpenAI (bio, përmbledhje skauti, sugjerime postimesh)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_DAILY_LIMIT_PER_USER=15

# YouTube test channel (optional — same as frontend VITE_YOUTUBE_TEST_CHANNEL_ID)
# YOUTUBE_TEST_CHANNEL_ID=UCflsCrcGKQ85RYdNM5oW27w
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Notes:
# - When running locally with a standard Postgres instance, set DB_HOST=localhost and DB_SSL=false.
# - Pa Postgres në laptop: kopjo `.env.remote.example` → `.env` dhe vendos DATABASE_URL nga Render.
#   Ose vetëm frontend: `frontend/.env.remote.example` → `frontend/.env` (API prod, pa backend lokal).
# - Smoke tests kundër prod: `npm run smoke:api:prod`
# - After creating .env, run `npm run dev` inside the `backend` folder to start the server.
