# Zhvillim lokal pa Postgres në laptop — lidhu me DB prod (Render).
# Kopjo në `.env` dhe plotëso vlerat nga Render Dashboard → Environment / Database.
#
# Opsioni A (vetëm frontend/mobile): mos nis backend lokal; përdor API prod:
#   frontend: kopjo ../frontend/.env.remote.example → frontend/.env
#
# Opsioni B (backend lokal + DB prod):
#   DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME
#   PGSSLMODE=require
#   JWT_SECRET=<i njëjti si në Render>
#   PORT=10000
#   NODE_ENV=development
#   PAYMENTS_ENABLED=false
#   MEDIASOUP_ADMIN_TOKEN=<nga Render nëse ke mediasoup>

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSLMODE=require

JWT_SECRET=copy_from_render
PORT=10000
NODE_ENV=development
PAYMENTS_ENABLED=false

# Smoke test (API prod, pa backend lokal):
#   npm run smoke:api:prod
#   TEST_EMAIL=... TEST_PASSWORD=... npm run smoke:api:prod
