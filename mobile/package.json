{
  "name": "footballpro-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build": "eas build --platform android --profile production",
    "eas-build:ios": "eas build --platform ios --profile production",
    "postinstall": "node scripts/patch-xcode26-compat.js",
    "smoke:checklist": "node scripts/smoke-checklist.js",
    "release:preflight": "node scripts/release-preflight.js",
    "verify:parity": "node scripts/verify-parity-modules.js",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "12.0.0",
    "@expo/vector-icons": "^14.1.0",
    "@livekit/react-native": "2.12.0",
    "@livekit/react-native-expo-plugin": "1.0.2",
    "@livekit/react-native-webrtc": "144.1.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.4.0",
    "expo": "~53.0.22",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-av": "~15.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-notifications": "~0.31.5",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "fast-text-encoding": "^1.0.6",
    "livekit-client": "^2.22.2",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-webview": "13.13.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/ngrok": "^4.1.3",
    "babel-preset-expo": "~13.0.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@config-plugins/react-native-webrtc",
          "@livekit/react-native-expo-plugin",
          "fast-text-encoding",
          "socket.io-client",
          "expo-av"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": []
    }
  }
}
