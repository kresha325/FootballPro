{
  "expo": {
    "name": "XTalenti",
    "slug": "x-talenti",
    "scheme": "footballpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0f172a",
          "defaultChannel": "default"
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "XTalenti ka nevojë për kamerën për live dhe video thirrje.",
          "microphonePermission": "XTalenti ka nevojë për mikrofonin për live dhe thirrje."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-iap"
    ],
    "android": {
      "package": "com.kresha325.xtalenti",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.kresha325.xtalenti",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "XTalenti ka nevojë për kamerën për live dhe video thirrje.",
        "NSMicrophoneUsageDescription": "XTalenti ka nevojë për mikrofonin për live dhe thirrje.",
        "NSPhotoLibraryUsageDescription": "XTalenti ka nevojë për galerinë për të zgjedhur foto dhe video për profil, postime dhe mesazhe.",
        "UIBackgroundModes": ["audio", "remote-notification"],
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "LSMinimumSystemVersion": "15.1"
      },
      "appleTeamId": "AM7TN896MK",
      "entitlements": {
        "aps-environment": "development"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["0A2A.1", "C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "BACKEND_URL": "https://footballpro.onrender.com",
      "WEB_APP_URL": "https://xtalenti.com",
      "ALLOW_MOBILE_DIGITAL_PURCHASES": true,
      "eas": {
        "projectId": "3352bbbe-2f86-4665-9a67-e0499d1051bc"
      }
    }
  }
}
