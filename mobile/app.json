{
  "expo": {
    "name": "X Talenti",
    "slug": "x-talenti",
    "scheme": "footballpro",
    "version": "1.0.0",
    "sdkVersion": "49.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "X Talenti ka nevojë për kamerën për live dhe video thirrje.",
          "microphonePermission": "X Talenti ka nevojë për mikrofonin për live dhe thirrje."
        }
      ]
    ],
    "android": {
      "package": "com.kresha325.footballpromobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kresha325.footballpromobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "X Talenti ka nevojë për kamerën për live dhe video thirrje.",
        "NSMicrophoneUsageDescription": "X Talenti ka nevojë për mikrofonin për live dhe thirrje."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "BACKEND_URL": "https://footballpro.onrender.com",
      "WEB_APP_URL": "https://footballpro-1.onrender.com"
    }
  }
}
