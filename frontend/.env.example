# .env file for Vite frontend
# Copy this file to .env and set the correct API URL
VITE_APP_NAME=FootballPro
VITE_API_URL=http://localhost:5000/api
# Kur frontend-i hapet përmes localtunnel (loca.lt), vendos URL-në e backend-it tunnel (pa /api në fund):
# VITE_LOCAL_TUNNEL_BACKEND_URL=https://your-backend-subdomain.loca.lt
VITE_MEDIASOUP_URL=http://localhost:4000

# WebRTC (VideoCallSimple fallback kur nuk përdoret vetëm LiveKit): TURN për rrjete strikte
# Opsioni A — lista JSON e plotë e RTCIceServer (bashkëngjitet pas STUN të Google):
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
# Opsioni B — vetëm URL-të e TURN-it (presje) + kredencialet:
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret
