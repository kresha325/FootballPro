# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# Environment variables and local secrets.
# Example files stay tracked. package-lock.json stays tracked because CI uses npm ci.
.env
.env.*
!.env.example
!**/.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx
certs/
secrets/
credentials/
credentials.json

# Build outputs
dist/
build/
backend/dist/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs, coverage, and debug output
logs/
*.log
coverage/
.nyc_output/
*.pid

# Local databases
*.sqlite
*.sqlite3
*.db

# Temporary files
.cache/
.temp/
tmp/

# Expo / EAS local state
.expo/
mobile/.expo/
**/web-build/

# Android signing (never commit)
*.keystore
