# /etc/mediasoup.env
# REQUIRED: public IP or domain reachable by clients
ANNOUNCED_IP=your.public.ip.or.domain

# Signaling (socket) URL exposed to clients
VITE_MEDIASOUP_URL=https://mediasoup.example.com

# Allowed origin for Socket.IO CORS (frontend app URL)
MEDIASOUP_CORS_ORIGIN=https://app.footballpro.example.com
FRONTEND_URL=https://app.footballpro.example.com

# Admin token used by mediasoup server to call backend viewer update endpoints
MEDIASOUP_ADMIN_TOKEN=replace-with-random-token

# Port and UDP ports used by mediasoup worker
MEDIASOUP_PORT=4000
MEDIASOUP_WORKER_MIN_PORT=40000
MEDIASOUP_WORKER_MAX_PORT=49999

# Backend API where mediasoup server can call to update streams/viewers
FOOTBALLPRO_API_URL=https://api.footballpro.example.com

# TURN server URIs (coturn)
TURN_URIS=turn:your.turn.server:3478
TURN_USER=turnuser
TURN_PASS=turnpass
