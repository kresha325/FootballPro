# coturn example configuration
# Install: apt install coturn

# Listening port for TURN/TLS
listening-port=3478

# Relay interfaces (server IP)
# Replace with your public IP or 0.0.0.0 to listen on all
# relay-ip=YOUR_PUBLIC_IP

# External IP (if behind NAT): external-ip=PUBLIC_IP/PRIVATE_IP
# external-ip=203.0.113.5/10.0.0.5

realm=mediasoup.example.com

# Use long-term credentials mechanism
lt-cred-mech

# Set static user (alternatively use dynamic REST api)
# Example: user=username:password
# user=turnuser:turnpass

# Enable fingerprint
fingerprint

# TLS certs (optional)
# cert=/etc/letsencrypt/live/mediasoup.example.com/fullchain.pem
# pkey=/etc/letsencrypt/live/mediasoup.example.com/privkey.pem

# Allow allocations to last long
allocation-ttl=600

# Enable verbose logging for troubleshooting
# verbose

# Recommended security settings
no-multicast-peers
no-tcp-relay

# If you use systemd socket activation, comment out the default file
# Also ensure coturn is enabled to start at boot
